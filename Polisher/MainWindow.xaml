<Window x:Class="Polisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Polisher.Views"
        Title="Polish Me Please (PMP)" Height="700" Width="1000"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="app_icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" MaxWidth="560">
                    <TextBlock Text="Polish Me Please" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Scan-based PC optimization — no random tweaks, just what your hardware needs."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="PolishButton" Content="✨ Polish My PC"
                        Style="{StaticResource PrimaryButton}" FontSize="14" Padding="22,12"
                        Click="PolishButton_Click"/>
            </Grid>
        </Border>

        <!-- ===================== Tabs ===================== -->
        <TabControl Grid.Row="1" Margin="20">

            <!-- ==================== PERFORMANCE ==================== -->
            <TabItem Header="Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Live System Monitor" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="CpuText" Text="--%" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="RAM" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RamText" Text="--" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Disk Used" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="DiskText" Text="--%" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Network" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="NetText" Text="Connected" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Startup Programs (by impact)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="StartupList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoStartupText" Text="No unnecessary startup entries found — nice and lean." 
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Power &amp; Performance Plan" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Power Saver" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PowerSaver_Click"/>
                                    <Button Content="Balanced" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PowerBalanced_Click"/>
                                    <Button Content="High Performance" Style="{StaticResource SecondaryButton}" Click="PowerHigh_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== VISUALS ==================== -->
            <TabItem Header="Visuals">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Appearance" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="VisualsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Wallpaper" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <Button Content="Choose Wallpaper..." Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Click="ChooseWallpaper_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== CLEANUP ==================== -->
            <TabItem Header="Cleanup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="What can be cleaned" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Content="Re-scan" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                            Padding="12,4" Click="RescanCleanup_Click"/>
                                </Grid>
                                <ItemsControl x:Name="CleanupList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== OPTIMIZATION ==================== -->
            <TabItem Header="Optimization">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="System Scan" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Content="Scan Now" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                            Padding="16,6" Click="ScanNow_Click"/>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Performance" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RatingPerformance" Text="—" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Storage" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RatingStorage" Text="—" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Startup" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RatingStartup" Text="—" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Background Activity" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RatingBackground" Text="—" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="ImprovementsHeader" Text="Scan completed — Polish found 0 improvements"
                                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="WhatAreTheyButton" Content="1. What are they?" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0" Click="WhatAreTheyButton_Click"/>
                                    <Button Content="2. Polish my PC" Style="{StaticResource PrimaryButton}" Click="PolishButton_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="ImprovementsList" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== PROFILES ==================== -->
            <TabItem Header="Profiles">
                <StackPanel Margin="6">
                    <TextBlock Text="Pick a profile — it pre-selects what to optimize. You can still fine-tune on the other tabs."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Rows="2">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Cursor="Hand" MouseLeftButtonUp="ProfileBalanced_Click">
                            <StackPanel>
                                <TextBlock Text="⚖️ Balanced" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Smoother without sacrificing Windows' appearance." Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="ProfilePerformance_Click">
                            <StackPanel>
                                <TextBlock Text="🚀 Performance" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Prioritizes responsiveness and gaming." Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="ProfileAesthetic_Click">
                            <StackPanel>
                                <TextBlock Text="🎨 Aesthetic" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Keeps Windows looking beautiful while optimizing everything else." Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Cursor="Hand" MouseLeftButtonUp="ProfileLowEnd_Click">
                            <StackPanel>
                                <TextBlock Text="🐢 Low-End" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Squeezes the most out of weaker hardware." Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="ProfileConfirmText" Text="" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ==================== SIN (watermark) ==================== -->
            <TabItem Header="Sin">
                <StackPanel Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource CardBorder}" Width="360" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Polish Me Please" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="made by Sin" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,20"/>

                            <Button Content="GitHub ↗" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                                    Click="GitHubLink_Click"/>
                            <Button Content="Support Me / Donations ↗" Style="{StaticResource PrimaryButton}"
                                    Click="DonateLink_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ===================== Polishing overlay, always on top ===================== -->
        <views:PolishingOverlay x:Name="Overlay" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</Window>
