<Window x:Class="Polisher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/app_icon.ico"
        Width="420" Height="420">

    <Grid>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.92" ScaleY="0.92" CenterX="210" CenterY="210"/>
        </Grid.RenderTransform>
        <Grid.Opacity>0</Grid.Opacity>

        <!-- Soft dark overlay so the white logo/text/bar stay readable over any desktop wallpaper -->
        <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#CC0B0C10" Offset="0"/>
                    <GradientStop Color="#000B0C10" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Rotating ring + static sparkle logo, all pure white -->
            <Grid Width="150" Height="150" HorizontalAlignment="Center">
                <Ellipse Width="150" Height="150" StrokeThickness="2.5" Stroke="#22FFFFFF"/>

                <Path x:Name="ArcPath" Width="150" Height="150" Stretch="None"
                      Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 75,3 A 72,72 0 0 1 147,75">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ArcRotate" CenterX="75" CenterY="75"/>
                    </Path.RenderTransform>
                </Path>

                <!-- Sparkle / polish mark -->
                <Path Data="M75,28 L84,66 L122,75 L84,84 L75,122 L66,84 L28,75 L66,66 Z"
                      Fill="White" Width="60" Height="60" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="LogoPulse" ScaleX="1" ScaleY="1" CenterX="30" CenterY="30"/>
                    </Path.RenderTransform>
                    <Path.Effect>
                        <DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                    </Path.Effect>
                </Path>
            </Grid>

            <TextBlock Text="POLISH ME PLEASE" Foreground="White" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,26,0,4" Opacity="0.92"/>
            <TextBlock Text="Warming up your PC..." Foreground="#AAFFFFFF" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,22"/>

            <!-- Progress track -->
            <Border Width="260" Height="6" CornerRadius="3" Background="#22FFFFFF" HorizontalAlignment="Center">
                <Border x:Name="ProgressFill" Width="0" Height="6" CornerRadius="3"
                        Background="White" HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</Window>
