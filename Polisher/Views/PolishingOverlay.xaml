<UserControl x:Class="Polisher.Views.PolishingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!-- Full-window dim backdrop -->
    <Grid Background="#B3000000">

        <!-- The rounded card -->
        <Border x:Name="Card" Width="380" MinHeight="300" CornerRadius="18"
                Background="#FF1D2029" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
            <Grid Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Close X, always available -->
                <Button x:Name="CloseButton" Grid.Row="0" Content="✕" HorizontalAlignment="Right"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="#9AA0AE" FontSize="13" Cursor="Hand" Click="CloseButton_Click"/>

                <!-- ===================== WORKING STATE ===================== -->
                <StackPanel x:Name="WorkingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                    <Grid Width="86" Height="86" HorizontalAlignment="Center">
                        <Ellipse Width="86" Height="86" StrokeThickness="4" Stroke="#2A2E3B"/>
                        <Path Width="86" Height="86" Stretch="None" Stroke="#5B8CFF" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 43,2 A 41,41 0 0 1 84,43">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="43" CenterY="43"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock Text="Optimizing..." Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBlock x:Name="WorkingStepText" Text="Getting started" Foreground="#9AA0AE" FontSize="12"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                </StackPanel>

                <!-- ===================== COMPLETE STATE ===================== -->
                <StackPanel x:Name="CompletePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" Margin="0,10,0,10">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#1F7CE0C4" HorizontalAlignment="Center">
                        <Path Data="M6,14 L12,20 L24,6" Stroke="#7CE0C4" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeLineJoin="Round" StrokeEndLineCap="Round"
                              Width="30" Height="26" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Optimization Complete!" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock x:Name="CompleteSubText" Text="Your PC has been polished." Foreground="#9AA0AE" FontSize="12"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                </StackPanel>

                <!-- Footer buttons: only visible in the complete state -->
                <StackPanel x:Name="CompleteButtons" Grid.Row="2" Visibility="Collapsed">
                    <Button x:Name="WhatWeOptimizedButton" Content="What did we Optimize?"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                            Click="WhatWeOptimizedButton_Click"/>
                    <Button x:Name="UnderstandButton" Content="I Understand"
                            Style="{StaticResource PrimaryButton}" Click="UnderstandButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== SUMMARY POPUP ("What did we optimize") ===================== -->
        <Border x:Name="SummaryPopup" Width="420" MaxHeight="480" CornerRadius="18" Background="#FF1D2029"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Padding="22">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="What We Optimized" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="26" Background="Transparent"
                            BorderThickness="0" Foreground="#9AA0AE" Cursor="Hand" Click="CloseSummary_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                    <ItemsControl x:Name="SummaryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF262A36" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ResultSummary}" FontSize="11" Foreground="#9AA0AE"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Content="Close" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"
                        Click="CloseSummary_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
